<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Company>JamTheRadar</Company>
    <Product>Muster</Product>
    <Authors>JamTheRadar</Authors>
    <Copyright>Copyright (c) 2026 James Noonan</Copyright>
    <RepositoryUrl>https://github.com/jamtheradar/Muster</RepositoryUrl>

    <!--
      One version for the assembly, the About screen and the Velopack release. Bump it here and
      nowhere else; the packaging script reads it back out of the built assembly rather than
      taking a second copy.
    -->
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
